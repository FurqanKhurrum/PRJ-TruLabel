.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv
pipenv/

# Database
*.db
*.sqlite
*.sqlite3
trulabel.db

# Environment Variables
.env
.env.local
.env.*.local

# IDE - PyCharm
.idea/
*.iml
*.iws
.idea_modules/

# ==================== FRONTEND (React Native) ====================
# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Testing
frontend/coverage/

# Production
frontend/build/

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React Native
frontend/.expo/
frontend/.expo-shared/
frontend/web-build/

# Metro
frontend/.metro-health-check*

# Android
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/.idea/
frontend/android/*.iml
frontend/android/captures/
frontend/android/gradlew
frontend/android/gradlew.bat
frontend/android/gradle/wrapper/gradle-wrapper.jar
*.apk
*.aab

# iOS
frontend/ios/Pods/
frontend/ios/**/*.xcodeproj/xcuserdata/
frontend/ios/**/*.xcworkspace/xcuserdata/
frontend/ios/build/
frontend/ios/.xcode.env.local
*.ipa
*.dSYM.zip
*.dSYM

